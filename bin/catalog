#!/usr/bin/env python3
"""Publish the Files provider only when its native host API is available."""
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
PLUGIN_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PLUGIN_ROOT / "lib"))
from host_support import CompatibilityError, require_host

try:
    require_host()
    descriptor = json.loads((PLUGIN_ROOT / "omalaunch.json").read_text(encoding="utf-8"))
except (CompatibilityError, OSError, ValueError) as error:
    print(f"Files Drag & Drop: {error}", file=sys.stderr)
    raise SystemExit(1)
print(json.dumps(descriptor, ensure_ascii=False))
