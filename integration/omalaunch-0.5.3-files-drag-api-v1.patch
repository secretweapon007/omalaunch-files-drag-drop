diff --git a/EXTENSIONS.md b/EXTENSIONS.md
index 920b9e0..e712f61 100644
--- a/EXTENSIONS.md
+++ b/EXTENSIONS.md
@@ -137,6 +137,20 @@ File browser extensions provide navigation, recursive search, opening, and path
 
 Ctrl+H toggles hidden files for the current file-browser session. Ctrl+K opens the contextual Action Panel. `command` opens files, `directoryCommand` opens directories in the file manager, `terminalCommand` opens a terminal, `copyCommand` copies the path, and `copyFileCommand` places a file URI on the clipboard. All command fields support `{path}`. Files and directories can be starred from the Action Panel or with Ctrl+S and then opened directly from the launcher’s starting view. Each star belongs to the exact provider that created it, so a replacement does not inherit bundled Files favorites. The bundled implementation starts at the home directory, uses `fd` traversal and fzf path ranking, omits hidden and ignored paths by default, includes hidden paths except `.git` internals for the current session after Ctrl+H, and limits each ranked result set to 100 entries. Exact basename matches rank before paths that match only through a parent directory, so many descendants cannot hide a matching file or directory. Recursive candidates are indexed once per active directory and reused while typing; the index refreshes after 30 seconds or when navigation changes directories.
 
+### Native file dragging
+
+A file-browser provider can opt into host-provided native dragging by setting `"dragAndDrop": true`. This optional field accepts only a boolean and is valid only with `mode: "files"`; declaring it on another mode, including `false`, rejects the definition. Omitting it or setting it to `false` preserves ordinary browsing without dragging. The opt-in belongs to the selected provider, so disabling or removing a replacement does not enable dragging on the bundled fallback.
+
+Hosts supporting this contract advertise `"files.drag-and-drop.v1"` in their own `manifest.json` at `omalaunch.hostFeatures`:
+
+```json
+"omalaunch": { "hostFeatures": ["files.drag-and-drop.v1"] }
+```
+
+Check this feature marker rather than a version number: an older host may ignore an unknown `dragAndDrop` field and still display the provider without supporting dragging. This declaration is host metadata, not an extension manifest requirement.
+
+The host makes real file and directory results draggable from browsing and recursive search into applications that accept file drops. It sends native `text/uri-list` data with copy-only semantics; it does not move or delete the original. The launcher gets out of the way during the drag and closes after the drop or cancellation. Parent-navigation rows, action-panel commands, and workflow pickers do not become drag sources. Extensions supply no QML or drag implementation.
+
 ## Workflow extension
 
 Workflow extensions contribute a launcher entry and a bounded tree of host-rendered stages. They can compose menus, text input, and Omalaunch's host-provided directory picker without shipping QML or implementing filesystem navigation:
@@ -441,6 +455,7 @@ The highest-priority matching live-query extension runs. Live queries debounce f
 - `command`: Argument array. Prefix mode supports `{prompt}`; query mode supports `{query}`; menu providers support `{extensionDir}`.
 - `configuration`: Optional menu-mode metadata with a registered bundled `provider`. Omalaunch then supplies the Settings · Ctrl+, footer shortcut and standard editor and agent actions.
 - `refreshable`: Default manual Ctrl+R behavior for the extension's menus and documents. It defaults to `false`; individual dynamic nodes can override it.
+- `dragAndDrop`: Optional files-mode boolean requesting the host's `files.drag-and-drop.v1` native-drag feature. Defaults to `false`; invalid in every other mode.
 
 Commands are argument arrays. Omalaunch substitutes placeholders and shell-quotes action arguments. Do not embed pipes, redirects, or other shell syntax.
 
diff --git a/FileDragSource.qml b/FileDragSource.qml
new file mode 100644
index 0000000..5af3652
--- /dev/null
+++ b/FileDragSource.qml
@@ -0,0 +1,38 @@
+import QtQuick
+import Quickshell
+import "MenuModel.js" as MenuModel
+
+// Keep the native drag alive independently of ListView delegate refreshes.
+Item {
+  id: root
+  property bool dragging: false
+  property string fileUrl: ""
+  property bool directory: false
+  signal finished(int action)
+
+  function begin(path, isDirectory) {
+    if (root.Drag.active || root.dragging) return
+    var url = MenuModel.localFileUrl(path)
+    if (!url) return
+    root.fileUrl = url
+    root.directory = isDirectory === true
+    root.Drag.active = true
+  }
+
+  Drag.dragType: Drag.Automatic
+  Drag.supportedActions: Qt.CopyAction
+  Drag.proposedAction: Qt.CopyAction
+  Drag.mimeData: ({ "text/uri-list": root.fileUrl + "\r\n" })
+  Drag.imageSource: Quickshell.iconPath(root.directory ? "folder" : "text-x-generic", true)
+  Drag.imageSourceSize: Qt.size(48, 48)
+  Drag.hotSpot: Qt.point(12, 12)
+  Drag.onDragStarted: root.dragging = true
+  Drag.onDragFinished: function(action) {
+    // Unmap the launcher only after Qt has finished its native drag loop.
+    Qt.callLater(function() {
+      root.dragging = false
+      root.fileUrl = ""
+      root.finished(action)
+    })
+  }
+}
