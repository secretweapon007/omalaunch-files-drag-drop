diff --git a/tests/menu-model-test.js b/tests/menu-model-test.js
index 3b73126..e4fcfce 100644
--- a/tests/menu-model-test.js
+++ b/tests/menu-model-test.js
@@ -99,6 +99,59 @@ assert(filesExtension[0].copyCommand[2] === '{path}', 'file browser copy path co
 assert(filesExtension[0].copyFileCommand[1] === '{path}', 'file browser copy file commands are retained')
 assert(filesExtension[0].terminalCommand[1] === '--dir={path}', 'file browser terminal commands are retained')
 assert(menu.extensionRootActivation(filesExtension[0]) === 'files', 'Files root activation selects the browser')
+assert(filesExtension[0].dragAndDrop === false, 'existing Files providers do not opt into native dragging implicitly')
+
+const dragFilesFixture = {
+  schemaVersion: 1,
+  id: 'example.drag-files',
+  capability: 'files',
+  mode: 'files',
+  label: 'Files with Drag-and-Drop',
+  prefixes: ['files'],
+  command: ['xdg-open', '{path}'],
+  priority: 10,
+  dragAndDrop: true
+}
+assert(menu.normalizeExtension(dragFilesFixture).dragAndDrop === true,
+  'Files providers can explicitly opt into native dragging')
+assert(menu.normalizeExtension({ ...dragFilesFixture, dragAndDrop: false }).dragAndDrop === false,
+  'Files providers can explicitly keep native dragging disabled')
+for (const invalidDragValue of [null, 0, 1, 'true', 'false', [], {}]) {
+  assert(menu.normalizeExtension({ ...dragFilesFixture, dragAndDrop: invalidDragValue }) === null,
+    `Files dragAndDrop rejects non-boolean ${JSON.stringify(invalidDragValue)}`)
+}
+for (const nonFilesMode of ['prefix', 'query', 'workflow', 'menu']) {
+  const nonFilesFixture = {
+    ...dragFilesFixture,
+    mode: nonFilesMode,
+    match: { all: ['.'] },
+    workflow: { items: [{ id: 'run', kind: 'action', label: 'Run', command: ['printf', 'example'] }] }
+  }
+  delete nonFilesFixture.dragAndDrop
+  assert(menu.normalizeExtension(nonFilesFixture) !== null, `${nonFilesMode} fixture is valid without dragAndDrop`)
+  for (const value of [true, false]) {
+    assert(menu.normalizeExtension({ ...nonFilesFixture, dragAndDrop: value }) === null,
+      `${nonFilesMode} providers cannot declare dragAndDrop even when ${value}`)
+  }
+}
+const bundledFilesFixture = {
+  ...dragFilesFixture,
+  id: 'omalaunch.files',
+  _bundled: true
+}
+delete bundledFilesFixture.dragAndDrop
+const selectedDragFiles = menu.parseExtensions(JSON.stringify([bundledFilesFixture, dragFilesFixture]))[0]
+assert(selectedDragFiles.id === dragFilesFixture.id && selectedDragFiles.dragAndDrop === true,
+  'an enabled external Files provider selects its own native-drag opt-in')
+const disabledDragFiles = menu.parseExtensions(JSON.stringify([bundledFilesFixture]))[0]
+assert(disabledDragFiles.id === bundledFilesFixture.id && disabledDragFiles.dragAndDrop === false,
+  'disabling the drag provider restores bundled Files without native dragging')
+const unavailableDragFiles = menu.parseExtensions(JSON.stringify([
+  bundledFilesFixture, { ...dragFilesFixture, _missingRequires: ['fixture-unavailable-command'] }
+]))[0]
+assert(unavailableDragFiles.id === bundledFilesFixture.id && unavailableDragFiles.dragAndDrop === false,
+  'an unavailable drag provider cannot enable dragging on the fallback provider')
+
 assert(menu.isImagePath('/tmp/Photo.JPEG'), 'image paths are recognized case-insensitively')
 assert(menu.isImagePath('/tmp/vector.svg'), 'SVG paths are recognized for previews')
 assert(!menu.isImagePath('/tmp/photo.jpeg.txt'), 'non-image paths do not get previews')
